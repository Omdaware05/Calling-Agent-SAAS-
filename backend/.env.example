# ==============================================================================
# ARB SoftTech AI Enterprise Calling Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the platform:
# Windows CMD: copy .env.example .env
# Linux / Mac: cp .env.example .env
# ==============================================================================

# ---- 1. Server & Public Webhook Configuration ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
ENVIRONMENT=development

# Public HTTPS URL for telecom carriers (VoBiz/Twilio) to stream audio:
# (Auto-detected from live Ngrok tunnel if left empty or localhost)
BACKEND_PUBLIC_URL=

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# Optional Backend Security API Key (leave empty for local access)
APP_API_KEY=

# ---- 2. Database Configuration ----
# Default: Zero-configuration SQLite stored cleanly in data/database/
DATABASE_URL=sqlite+aiosqlite:///./calling_agent.db

# Production Alternative: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/voxora

# ---- 3. Native Sarvam AI Telephony Engine (High-Performance Mode) ----
VOICE_ENGINE=sarvam
ACTIVE_MODEL_MODE=sarvam

# Sarvam AI API Key (Get free key from https://www.sarvam.ai/)
SARVAM_API_KEY=sk_nipv0trp_igNxLgrUcrqEGnKbEk1pSViR
SARVAM_DEFAULT_VOICE=shubh
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations

# ---- 4. Google Gemini AI (Lead Interest Intelligence) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- 5. VoBiz Telephony Provider (PSTN Cellular Outbound Calling) ----
# Get from VoBiz portal: https://vobiz.ai/
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+918065354620
VOBIZ_APPLICATION_ID=

# ---- 6. Twilio Telephony Provider (Optional Alternative) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- 7. Dograh Voice Platform & Object Storage (Optional) ----
DOGRAH_BASE_URL=http://localhost:8000
DOGRAH_API_KEY=sk-placeholder-key
DOGRAH_WEBHOOK_SECRET=

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voxora-recordings
S3_REGION=us-east-1
