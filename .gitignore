# ============================================================
# Git Ignore - Calling Agent Platform
# ============================================================

# --- Environments & Secrets (NEVER COMMIT SENSITIVE KEYS) ---
.env
*.env
backend/.env
frontend_1/.env
dograh/.env

# --- Node / Frontend Dependencies ---
node_modules/
frontend_1/node_modules/
dist/
frontend_1/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python Virtual Environments ---
.venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Python Cache & Bytecode ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.pyc

# --- Database & Storage Files ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
calling_agent.db
backend/calling_agent.db
/recordings/
/backend/app/recordings/

# --- Unified Client Data Directory ---
data/recordings/*
!data/recordings/.gitkeep
data/transcripts/*
!data/transcripts/.gitkeep
data/intelligence/*
!data/intelligence/.gitkeep
data/database/*
!data/database/.gitkeep
data/logs/*
!data/logs/.gitkeep
bin/*
!bin/.gitkeep

# --- Audio Files & Test Scratch ---
*.wav
*.mp3
*.ogg
scratch_*.wav
test_*.wav

# --- Testing, Logs & Reports ---
.pytest_cache/
backend/.pytest_cache/
model/.pytest_cache/
/reports/
*.log
*.zip
*.tar.gz
*.tsbuildinfo

# --- IDE & Editor Configuration ---
.vscode/
backend/.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
